# Copy this file to .env and fill it in. server.js reads .env when it starts; variables set in the
# environment win over it. Keep .env private: it holds your RPC key, and it is in .gitignore.
# Docker: pass it with `docker run --env-file .env ...` (it is not copied into the image).

# ---- Mainnet payments: fill these in before going live ----
SOLANA_CLUSTER=mainnet
# Your Solana wallet address. Fast mode payments go here; empty keeps Fast mode free.
PAY_TO=
# RPC provider URL with your key, for example https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Empty uses Solana's public RPC, which rate-limits busy sites.
SOLANA_RPC=
PRICE_SOL=0.01
PRICE_SOL_PER_HOUR=0.1
# With PAY_TO set, every search is paid and runs on this server. on also keeps the free search on the
# visitor's own device (Fast mode is then the paid option).
DEVICE_SEARCH=off

# ---- Who runs the site: header, footer, link previews and the legal page ----
SITE_NAME=Plates
# Public address of the site
SITE_URL=https://getplates.fun
# At least one of these, so paying customers can reach you for refunds
CONTACT_EMAIL=
CONTACT_TELEGRAM=
OPERATOR_NAME=
# Country whose laws govern the terms, for example Indonesia
JURISDICTION=
SOURCE_URL=
# The project's X account (off hides it), and the token's contract address (empty shows "CA: Coming soon")
X_URL=https://x.com/platesfun
TOKEN_CA=

# ---- Server ----
PORT=8080
ENGINE=auto
TRUST_PROXY=1
MAX_EXPECTED_SECONDS=3600
MAX_QUEUE=25
MAX_UNPAID=50
MAX_JOBS_PER_IP=1
PAY_WINDOW_SECONDS=900
PAID_RESULT_TTL_SECONDS=86400
